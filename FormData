import io.ktor.client.request.*
import io.ktor.client.request.forms.*
import io.ktor.client.statement.*
import io.ktor.http.*
import io.ktor.serialization.kotlinx.json.*
import io.ktor.utils.io.core.*
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.launch
import kotlinx.serialization.json.Json

class RegisterScreenModel : ScreenModel {

    private val client = HttpClient {
        install(ContentNegotiation) {
            json(Json { ignoreUnknownKeys = true })
        }
        install(Logging) {  // <-- Logging plugin to see request/response
            logger = Logger.SIMPLE
            level = LogLevel.ALL
        }
    }

    private val baseUrl = "http://10.0.2.2:5000/student" // Spring Boot backend

    // Form fields
    val stuName = MutableStateFlow("")
    val stuCity = MutableStateFlow("")
    val stuMarks = MutableStateFlow("")

    // Result and students list
    private val _result = MutableStateFlow("")
    val result: StateFlow<String> = _result

    private val _students = MutableStateFlow<List<Student>>(emptyList())
    val students: StateFlow<List<Student>> = _students

    /**
     * Add student with optional image
     */
    // Fix client side `addStudent` function
    fun addStudent(imageBytes: ByteArray? = null, imageName: String = "upload.jpg") {
        screenModelScope.launch {
            try {
//                val marks = 60.toDoubleOrNull() ?: 0.0

                val response: HttpResponse = client.submitFormWithBinaryData(
                    url = "$baseUrl/create",
                    formData = formData {
                        append("stuName", "abc")
                        append("stuCity", "def")
                        append("stuMarks","80")

                        if (imageBytes != null) {
                            // Correct way: Let Ktor build the headers
                            // The first argument "image" should match the server's @RequestParam name
                            append("file", imageBytes, Headers.build {
                                append(HttpHeaders.ContentType, "image/jpeg")
                                append(HttpHeaders.ContentDisposition, "filename=\"$imageName\"")
                            })
                        }
                    }
                )

                // Log backend response
                val text = response.bodyAsText()
                println("Response: $text")

                _result.value = if (response.status.isSuccess()) {
                    "✅ Student created successfully!"
                } else {
                    "❌ Failed: ${response.status}"
                }

                // Reload students list if success
                if (response.status.isSuccess()){}
//                    loadStudents()

            } catch (e: Exception) {
                _result.value = "❌ Error: ${e.message}"
                e.printStackTrace()
            }
        }
    }
    /**
     * Load students list from backend
     */
    suspend fun loadImageForStudent(studentId: Long): ByteArray? {
        return try {
            val response: HttpResponse = client.get("$baseUrl/view/$studentId")
            if (response.status.isSuccess()) {
                response.readBytes()
            } else {
                null
            }
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }


    fun resetForm() {
        stuName.value = ""
        stuCity.value = ""
        stuMarks.value = ""
    }
}



