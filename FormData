class RegisterScreen : Screen {
    @Composable
    override fun Content() {
        val navigator = LocalNavigator.current
        val screenModel = rememberScreenModel { RegisterScreenModel() }

        val scope = rememberCoroutineScope()
        val context = LocalPlatformContext.current

        // keep track of selected file bytes + name
        var byteArray by remember { mutableStateOf<ByteArray?>(null) }
        var fileName by remember { mutableStateOf("upload.jpg") }

//        val context = LocalPlatformContext.current

        val pickUpLauncher = rememberFilePickerLauncher(
            type = FilePickerFileType.Image,
            selectionMode = FilePickerSelectionMode.Single,
            onResult = { files ->
                scope.launch {
                    files.firstOrNull()?.let { file ->
                        byteArray = file.readByteArray(context = context)
                        fileName = "apple"
                    }
                }
            }
        )

        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(color = Color.LightGray),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center,
        ) {
            Button(
                onClick = { pickUpLauncher.launch() },
                modifier = Modifier
                    .fillMaxWidth(0.7f)
                    .fillMaxHeight(0.17f),
                colors = ButtonDefaults.buttonColors(containerColor = Color.Blue)
            ) {
                Text("Pick File", color = Color.White, fontSize = 20.sp)
            }

            Button(
                onClick = {
                    scope.launch {
                        screenModel.addStudent(
                            imageBytes = byteArray,
                            imageName = fileName
                        )
                    }
                },
                modifier = Modifier
                    .fillMaxWidth(0.7f)
                    .fillMaxHeight(0.17f),
                colors = ButtonDefaults.buttonColors(containerColor = Color.Green)
            ) {
                Text("Upload Student", color = Color.White, fontSize = 20.sp)
            }

            // Show result feedback
            val result by screenModel.result.collectAsState()
            Text(
                text = result,
                color = Color.Black,
                modifier = Modifier.padding(top = 16.dp)
            )
        }
    }
}


